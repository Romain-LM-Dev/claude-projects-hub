{
  "name": "claude-projects-hub",
  "displayName": "Projects Hub for Claude Code",
  "description": "Hub de projets et de topics pour Claude Code.",
  "version": "0.0.1",
  "publisher": "romain-lm-dev",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Romain-LM-Dev/claude-projects-hub"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeHub",
          "title": "Claude Hub",
          "icon": "$(library)"
        }
      ]
    },
    "views": {
      "claudeHub": [
        {
          "id": "claudeProjectsHub.projects",
          "name": "Projets"
        },
        {
          "id": "claudeProjectsHub.globalMemory",
          "name": "Mémoire globale"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeProjectsHub.refresh",
        "title": "Rafraîchir",
        "category": "Claude Hub",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeProjectsHub.newTopic",
        "title": "Nouveau topic",
        "category": "Claude Hub",
        "icon": "$(add)"
      },
      {
        "command": "claudeProjectsHub.deleteTopic",
        "title": "Supprimer le topic",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.importTopic",
        "title": "Importer en topic",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.resumeInClaude",
        "title": "Reprendre dans Claude",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.resumeInTerminal",
        "title": "Reprendre dans un terminal",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.openFolder",
        "title": "Ouvrir le dossier",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.diagnostics",
        "title": "Diagnostic",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.attachProject",
        "title": "Rattacher à un projet…",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.detachDir",
        "title": "Détacher ce dossier",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.dismissCandidate",
        "title": "Ignorer ce candidat",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.dismissOrphan",
        "title": "Ignorer l'orphelin",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.undoMerge",
        "title": "Annuler le dernier rattachement",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.copyAutoMemory",
        "title": "Copier l'auto-mémoire",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.refreshFingerprints",
        "title": "Rafraîchir les empreintes",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.previewInjection",
        "title": "Aperçu de l'injection",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.installIntegration",
        "title": "Installer l'intégration Claude",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.removeIntegration",
        "title": "Retirer l'intégration",
        "category": "Claude Hub"
      }
    ],
    "configuration": {
      "title": "Claude Hub",
      "properties": {
        "claudeProjectsHub.showTemporaryProjects": {
          "type": "boolean",
          "default": false,
          "description": "Afficher le nœud « Temporaires » (sessions des dossiers exclus)."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeProjectsHub.refresh",
          "when": "view == claudeProjectsHub.projects",
          "group": "navigation@2"
        },
        {
          "command": "claudeProjectsHub.newTopic",
          "when": "view == claudeProjectsHub.projects",
          "group": "navigation@1"
        },
        {
          "command": "claudeProjectsHub.refresh",
          "when": "view == claudeProjectsHub.globalMemory",
          "group": "navigation@2"
        },
        {
          "command": "claudeProjectsHub.newTopic",
          "when": "view == claudeProjectsHub.globalMemory",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeProjectsHub.newTopic",
          "when": "viewItem == memoryGroup",
          "group": "inline"
        },
        {
          "command": "claudeProjectsHub.deleteTopic",
          "when": "viewItem == topic"
        },
        {
          "command": "claudeProjectsHub.importTopic",
          "when": "viewItem == note"
        },
        {
          "command": "claudeProjectsHub.resumeInClaude",
          "when": "viewItem == session"
        },
        {
          "command": "claudeProjectsHub.resumeInTerminal",
          "when": "viewItem == session"
        },
        {
          "command": "claudeProjectsHub.openFolder",
          "when": "viewItem == project"
        },
        {
          "command": "claudeProjectsHub.attachProject",
          "when": "viewItem == project"
        },
        {
          "command": "claudeProjectsHub.detachDir",
          "when": "viewItem == project"
        },
        {
          "command": "claudeProjectsHub.copyAutoMemory",
          "when": "viewItem == project"
        },
        {
          "command": "claudeProjectsHub.previewInjection",
          "when": "viewItem == project"
        },
        {
          "command": "claudeProjectsHub.attachProject",
          "when": "viewItem == proposal"
        },
        {
          "command": "claudeProjectsHub.dismissCandidate",
          "when": "viewItem == proposal"
        },
        {
          "command": "claudeProjectsHub.dismissOrphan",
          "when": "viewItem == proposal"
        },
        {
          "command": "claudeProjectsHub.copyAutoMemory",
          "when": "viewItem == proposal"
        },
        {
          "command": "claudeProjectsHub.attachProject",
          "when": "viewItem == orphan"
        },
        {
          "command": "claudeProjectsHub.dismissOrphan",
          "when": "viewItem == orphan"
        },
        {
          "command": "claudeProjectsHub.copyAutoMemory",
          "when": "viewItem == orphan"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeProjectsHub.attachProject",
          "when": "false"
        },
        {
          "command": "claudeProjectsHub.detachDir",
          "when": "false"
        },
        {
          "command": "claudeProjectsHub.dismissCandidate",
          "when": "false"
        },
        {
          "command": "claudeProjectsHub.dismissOrphan",
          "when": "false"
        },
        {
          "command": "claudeProjectsHub.copyAutoMemory",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "test:ext": "node test/extension/run.ts",
    "probe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/probe.ts",
    "package": "vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
