{
  "name": "claude-projects-hub",
  "displayName": "Projects Hub for Claude Code",
  "description": "%description%",
  "version": "0.7.0",
  "publisher": "romain-lm-dev",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Romain-LM-Dev/claude-projects-hub"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeHub",
          "title": "Claude Hub",
          "icon": "$(library)"
        }
      ]
    },
    "views": {
      "claudeHub": [
        {
          "id": "claudeProjectsHub.projects",
          "name": "%view.projects%"
        },
        {
          "id": "claudeProjectsHub.globalMemory",
          "name": "%view.globalMemory%"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeProjectsHub.refresh",
        "title": "%command.refresh%",
        "category": "Claude Hub",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeProjectsHub.newTopic",
        "title": "%command.newTopic%",
        "category": "Claude Hub",
        "icon": "$(add)"
      },
      {
        "command": "claudeProjectsHub.deleteTopic",
        "title": "%command.deleteTopic%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.importTopic",
        "title": "%command.importTopic%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.resumeInClaude",
        "title": "%command.resumeInClaude%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.resumeInTerminal",
        "title": "%command.resumeInTerminal%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.openFolder",
        "title": "%command.openFolder%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.diagnostics",
        "title": "%command.diagnostics%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.attachProject",
        "title": "%command.attachProject%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.detachDir",
        "title": "%command.detachDir%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.dismissCandidate",
        "title": "%command.dismissCandidate%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.dismissOrphan",
        "title": "%command.dismissOrphan%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.orphanHelp",
        "title": "%command.orphanHelp%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.undoMerge",
        "title": "%command.undoMerge%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.copyAutoMemory",
        "title": "%command.copyAutoMemory%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.deleteSessions",
        "title": "%command.deleteSessions%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.deleteOrphan",
        "title": "%command.deleteOrphan%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.deleteProject",
        "title": "%command.deleteProject%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.refreshFingerprints",
        "title": "%command.refreshFingerprints%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.previewInjection",
        "title": "%command.previewInjection%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.installIntegration",
        "title": "%command.installIntegration%",
        "category": "Claude Hub"
      },
      {
        "command": "claudeProjectsHub.removeIntegration",
        "title": "%command.removeIntegration%",
        "category": "Claude Hub"
      }
    ],
    "configuration": {
      "title": "Claude Hub",
      "properties": {
        "claudeProjectsHub.showTemporaryProjects": {
          "type": "boolean",
          "default": false,
          "description": "%config.showTemporaryProjects%"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeProjectsHub.refresh",
          "when": "view == claudeProjectsHub.projects",
          "group": "navigation@2"
        },
        {
          "command": "claudeProjectsHub.newTopic",
          "when": "view == claudeProjectsHub.projects",
          "group": "navigation@1"
        },
        {
          "command": "claudeProjectsHub.refresh",
          "when": "view == claudeProjectsHub.globalMemory",
          "group": "navigation@2"
        },
        {
          "command": "claudeProjectsHub.newTopic",
          "when": "view == claudeProjectsHub.globalMemory",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeProjectsHub.orphanHelp",
          "when": "viewItem == orphan",
          "group": "0_help"
        },
        {
          "command": "claudeProjectsHub.orphanHelp",
          "when": "viewItem == proposal",
          "group": "0_help"
        },
        {
          "command": "claudeProjectsHub.newTopic",
          "when": "viewItem == memoryGroup",
          "group": "inline"
        },
        {
          "command": "claudeProjectsHub.deleteTopic",
          "when": "viewItem == topic"
        },
        {
          "command": "claudeProjectsHub.importTopic",
          "when": "viewItem == note"
        },
        {
          "command": "claudeProjectsHub.resumeInClaude",
          "when": "viewItem == session"
        },
        {
          "command": "claudeProjectsHub.resumeInTerminal",
          "when": "viewItem == session"
        },
        {
          "command": "claudeProjectsHub.openFolder",
          "when": "viewItem == project"
        },
        {
          "command": "claudeProjectsHub.attachProject",
          "when": "viewItem == project"
        },
        {
          "command": "claudeProjectsHub.detachDir",
          "when": "viewItem == project"
        },
        {
          "command": "claudeProjectsHub.copyAutoMemory",
          "when": "viewItem == project"
        },
        {
          "command": "claudeProjectsHub.previewInjection",
          "when": "viewItem == project"
        },
        {
          "command": "claudeProjectsHub.attachProject",
          "when": "viewItem == proposal"
        },
        {
          "command": "claudeProjectsHub.dismissCandidate",
          "when": "viewItem == proposal"
        },
        {
          "command": "claudeProjectsHub.dismissOrphan",
          "when": "viewItem == proposal"
        },
        {
          "command": "claudeProjectsHub.copyAutoMemory",
          "when": "viewItem == proposal"
        },
        {
          "command": "claudeProjectsHub.attachProject",
          "when": "viewItem == orphan"
        },
        {
          "command": "claudeProjectsHub.dismissOrphan",
          "when": "viewItem == orphan"
        },
        {
          "command": "claudeProjectsHub.copyAutoMemory",
          "when": "viewItem == orphan"
        },
        {
          "command": "claudeProjectsHub.deleteSessions",
          "when": "viewItem == session",
          "group": "z_danger"
        },
        {
          "command": "claudeProjectsHub.deleteSessions",
          "when": "viewItem == project",
          "group": "z_danger"
        },
        {
          "command": "claudeProjectsHub.deleteProject",
          "when": "viewItem == project",
          "group": "z_danger"
        },
        {
          "command": "claudeProjectsHub.deleteSessions",
          "when": "viewItem == orphan",
          "group": "z_danger"
        },
        {
          "command": "claudeProjectsHub.deleteOrphan",
          "when": "viewItem == orphan",
          "group": "z_danger"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeProjectsHub.orphanHelp",
          "when": "false"
        },
        {
          "command": "claudeProjectsHub.attachProject",
          "when": "false"
        },
        {
          "command": "claudeProjectsHub.detachDir",
          "when": "false"
        },
        {
          "command": "claudeProjectsHub.dismissCandidate",
          "when": "false"
        },
        {
          "command": "claudeProjectsHub.dismissOrphan",
          "when": "false"
        },
        {
          "command": "claudeProjectsHub.copyAutoMemory",
          "when": "false"
        },
        {
          "command": "claudeProjectsHub.deleteSessions",
          "when": "false"
        },
        {
          "command": "claudeProjectsHub.deleteOrphan",
          "when": "false"
        },
        {
          "command": "claudeProjectsHub.deleteProject",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "test:ext": "node test/extension/run.ts",
    "probe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/probe.ts",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
